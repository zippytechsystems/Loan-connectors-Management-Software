# Dependencies
node_modules/
package-lock.json

# Environment variables & secrets
.env
.env.local
.env.*.local

# SQLite Local Database files & WAL artifacts
data/*.sqlite*
data/*.db*
!data/.gitkeep

# Point-in-time Database Backups
backups/*.sqlite*
backups/*.sql*
backups/*.gz
!backups/.gitkeep

# Encrypted Vault Storage (local test uploads)
storage/kyc_vault/*
!storage/kyc_vault/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System & IDE artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.tmp
