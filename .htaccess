# ==============================================================================
# Zippy Loan Connector Loan Software Application
# Hostinger LiteSpeed / Apache Web Server Configuration (.htaccess)
# ==============================================================================

# Prevent Directory Browsing (Prevents directory exposure)
Options -Indexes

# Set Default Index Document
DirectoryIndex index.html public/index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Forward API routes to Node.js backend if proxy module available
  <IfModule mod_proxy.c>
    RewriteCond %{REQUEST_URI} ^/api/ [NC]
    RewriteRule ^api/(.*)$ http://127.0.0.1:3000/api/$1 [P,L]
  </IfModule>

  # 2. Serve static assets directly from public/ if present
  RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
  RewriteRule ^(.*)$ public/$1 [L]

  # 3. Clean URLs for Marketing Pages
  RewriteRule ^hyderabad-nacharam/?$ public/hyderabad-nacharam.html [L]
  RewriteRule ^connector-network/?$ public/connector-network.html [L]
  RewriteRule ^loan-products/?$ public/loan-products.html [L]
  RewriteRule ^about/?$ public/about.html [L]
  RewriteRule ^contact/?$ public/contact.html [L]
  RewriteRule ^privacy-policy/?$ public/privacy-policy.html [L]
  RewriteRule ^terms/?$ public/terms.html [L]

  # 4. Clean URLs for Application Workspace & Portal
  RewriteRule ^app/?$ public/app.html [L]
  RewriteRule ^workspace/?$ public/app.html [L]
  RewriteRule ^portal/?$ public/app.html [L]
  RewriteRule ^login/?$ public/app.html [L]

  # 5. Root Homepage
  RewriteRule ^$ public/index.html [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
