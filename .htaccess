# =============================================================================
# ZIPPY LOAN CONNECTOR — HOSTINGER APACHE / LITESPEED CONFIGURATION
# Application: Zippy Loan Connector
# Owner: M. Lingaswamy
# =============================================================================

DirectoryIndex index.html

# 1. Security: Block direct access to hidden files, git, and environment variables
<FilesMatch "^\.(env|git|gitignore)">
  Require all denied
</FilesMatch>

# 2. Block direct HTTP listing of server code and node_modules
RewriteEngine On
RewriteBase /

# Block access to server backend code directly via browser
RewriteRule ^server(/.*)?$ - [F,L]
RewriteRule ^migrations(/.*)?$ - [F,L]

# 3. Single Page Application (SPA) Routing for React Router
# If request is NOT an actual file or directory, serve index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.html [QSA,L]

# 4. Enable compression for speed
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
