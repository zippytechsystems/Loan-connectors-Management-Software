# =============================================================================
# ZIPPY LOAN CONNECTOR — HOSTINGER APACHE / LITESPEED CONFIGURATION
# Application: Zippy Loan Connector
# Owner: M. Lingaswamy
# =============================================================================

DirectoryIndex index.html

# 1. Security: Block direct access to hidden files, git, and environment variables
<FilesMatch "^\.(env|git|gitignore)">
  Require all denied
</FilesMatch>

# 2. Block direct HTTP listing of server backend code and migrations
RewriteEngine On
RewriteBase /

RewriteRule ^server(/.*)?$ - [F,L]
RewriteRule ^migrations(/.*)?$ - [F,L]

# 3. Node.js API Reverse Proxy (when mod_proxy is active on LiteSpeed / Apache)
<IfModule mod_proxy.c>
  RewriteRule ^api/(.*)$ http://127.0.0.1:5000/api/$1 [P,L]
</IfModule>

# 4. Critical: NEVER rewrite /api requests to index.html under any circumstances
RewriteCond %{REQUEST_URI} ^/api(/.*)?$ [NC]
RewriteRule ^ - [L]

# 5. Single Page Application (SPA) Routing for React Router
# If request is NOT an actual file or directory, serve index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.html [QSA,L]

# 6. Enable compression for speed
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
