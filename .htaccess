# =============================================================================
# ZIPPY LOAN CONNECTOR — HOSTINGER APACHE / LITESPEED CONFIGURATION
# Application: Zippy Loan Connector
# Owner: M. Lingaswamy
# =============================================================================

DirectoryIndex index.html

# 1. Security: Block direct access to hidden files, git, and environment variables
<FilesMatch "^\.(env|git|gitignore)">
  Require all denied
</FilesMatch>

# 2. Rewrite Rules
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Block direct access to backend server source code and migrations
  RewriteRule ^server(/.*)?$ - [F,L]
  RewriteRule ^migrations(/.*)?$ - [F,L]

  # Route /api calls directly to Node.js backend on localhost:5000
  RewriteRule ^api/(.*)$ http://127.0.0.1:5000/api/$1 [P,L]
  RewriteRule ^api$ http://127.0.0.1:5000/api [P,L]

  # Single Page Application (SPA) Routing for React Router (Frontend)
  # Only rewrite non-existent files that are NOT API endpoints
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api
  RewriteRule ^(.*)$ index.html [QSA,L]
</IfModule>

# 3. Enable compression for speed
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
