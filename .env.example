# =============================================================================
# ZIPPY LOAN CONNECTOR — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file with production credentials to GitHub!
# =============================================================================

# Server Port and Environment
# In local development: PORT=5000 (React Vite runs on 3000 with /api proxy)
# In Hostinger Production: process.env.PORT is automatically assigned by Hostinger
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# HOSTINGER MYSQL DATABASE CREDENTIALS
# -----------------------------------------------------------------------------
# When deployed directly on Hostinger web server (Node.js):
#   DB_HOST is typically 127.0.0.1 (local to the server)
# When connecting from your local dev machine to Hostinger remotely:
#   DB_HOST is your remote MySQL host (e.g., srv1555.hstgr.io)
#   Ensure "Remote MySQL" is enabled in Hostinger hPanel with IP allowed (%)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u914601002_DSA_management
DB_USER=u914601002_DSA_database
DB_PASSWORD=M.Linga@123

# MySQL Pool Connection Options
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000

# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION SECRETS
# -----------------------------------------------------------------------------
# High-entropy random secret key for signing JWTs / session cookies (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=zippy_loan_connector_super_secure_session_secret_change_in_production_98412498

# Cookie Settings
COOKIE_NAME=zippy_auth_token
COOKIE_MAX_AGE_DAYS=7

# -----------------------------------------------------------------------------
# INITIAL ADMIN CREDENTIALS (M. Lingaswamy)
# -----------------------------------------------------------------------------
# The server-side bootstrap script will automatically seed this account on first start.
ADMIN_USERNAME=M.Lingaswamy@123
ADMIN_INITIAL_PASSWORD=M.Linga@123
ADMIN_SYNC_PASSWORD=true
