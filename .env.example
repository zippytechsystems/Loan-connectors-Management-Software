# Veridian Loan Connector Management Software - Environment Configuration
# Copy this file to .env for custom deployment settings

PORT=4180
HOST=127.0.0.1
NODE_ENV=development

# -----------------------------------------------------------------------------
# DATABASE SELECTION: 'sqlite' (Development/Testing) vs 'mysql' (Hostinger Production)
# -----------------------------------------------------------------------------
DB_CLIENT=sqlite

# Local SQLite Database (Used when DB_CLIENT=sqlite)
CONNECTOR_DB=data/connector_network.sqlite

# Hostinger MySQL Database (Required when DB_CLIENT=mysql in production)
# Hostinger MySQL runs locally on the web server; connect via 127.0.0.1:3306
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=u123456789_veridian_user
MYSQL_PASSWORD=StrongHostingerDbPassword2026!
MYSQL_DATABASE=u123456789_veridian_db
MYSQL_SSL=false
MYSQL_CONNECTION_LIMIT=10

# -----------------------------------------------------------------------------
# SECURITY & SESSION SECRETS (MANDATORY TO CHANGE IN PRODUCTION)
# -----------------------------------------------------------------------------
# Generate high-entropy 64-character hex strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev_session_secret_change_in_production_89417265934
ENCRYPTION_KEY_SECRET=dev_enc_key_change_in_prod_6872364817263548
COOKIE_NAME=veridian_connector_sess

# Security Features
STRICT_CSRF=false
RATE_LIMIT_MAX_PER_MINUTE=200
MFA_ENFORCED_FOR_ADMINS=false
PRODUCTION_HARDENED=false
JURISDICTION_COMPLIANCE_MODE=IN_DPDP_ACT_2023

# Document Storage (Private storage path outside public web folder)
DOCUMENT_STORAGE_DIR=storage/kyc_vault

# -----------------------------------------------------------------------------
# DOMAIN, HOSTINGER URL & GOOGLE SEARCH CONSOLE (HYDERABAD & NACHARAM LOCAL SEO)
# -----------------------------------------------------------------------------
PUBLIC_DOMAIN=https://veridianconnector.com
# Google Search Console Verification Meta Tag Content (provided by owner)
# Example: GSC_VERIFICATION_TAG=abcdef1234567890_GoogleVerificationToken
GSC_VERIFICATION_TAG=

# -----------------------------------------------------------------------------
# GOOGLE OAUTH / GMAIL SIGN-IN (CONFIGURABLE BY OWNER)
# -----------------------------------------------------------------------------
# Create OAuth 2.0 Client in Google Cloud Console -> APIs & Services -> Credentials
# Authorized redirect URI: https://yourdomain.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://veridianconnector.com/api/v1/auth/google/callback

# -----------------------------------------------------------------------------
# OUTBOUND EMAIL / SMTP NOTIFICATIONS (FOR LEAD TASKS & REMINDERS)
# -----------------------------------------------------------------------------
# Hostinger Titan Mail or standard SMTP configuration
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=notifications@yourdomain.com
SMTP_PASSWORD=YourSmtpAppPassword2026!
SMTP_FROM="Veridian Connector OS <notifications@yourdomain.com>"
SMTP_SECURE=false

# -----------------------------------------------------------------------------
# COMMISSION PAYOUT GATEWAY INTEGRATION (NEFT / RTGS DISBURSEMENTS)
# -----------------------------------------------------------------------------
# Options: 'manual_neft' (default ledger recording) | 'razorpayx' | 'cashfree'
PAYOUT_PROVIDER=manual_neft
PAYOUT_KEY_ID=
PAYOUT_KEY_SECRET=
PAYOUT_WEBHOOK_SECRET=
