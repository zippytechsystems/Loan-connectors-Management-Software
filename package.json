{
  "name": "zippy-loan-connector",
  "version": "1.0.0",
  "description": "Zippy Loan Connector — Management Software",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "build:client": "npm --workspace=client run build && node -e \"const fs=require('fs'); fs.cpSync('client/dist', '.', { recursive: true });\"",
    "build": "npm run build:client",
    "start": "npm --workspace=server run start",
    "db:test": "npm --workspace=server run db:test",
    "db:init": "npm --workspace=server run db:init",
    "test": "npm --workspace=server run test"
  },
  "keywords": [
    "loan-connector",
    "fintech",
    "zippy-loan-connector",
    "hostinger-mysql"
  ],
  "author": "M. Lingaswamy",
  "license": "UNLICENSED"
}
