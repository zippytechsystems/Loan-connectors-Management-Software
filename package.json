{
  "name": "zippy-loan-connector",
  "version": "1.0.0",
  "description": "Zippy Loan Connector — Management Software",
  "private": true,
  "type": "module",
  "main": "server.js",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "build:client": "npm --workspace=client run build && node -e \"import('fs').then(fs => { fs.cpSync('client/dist', 'dist', { recursive: true }); fs.cpSync('client/dist', '.', { recursive: true }); if (fs.existsSync('.htaccess')) { fs.copyFileSync('.htaccess', 'dist/.htaccess'); } })\"",
    "build": "npm run build:client",
    "start": "node server.js",
    "db:test": "npm --workspace=server run db:test",
    "db:init": "npm --workspace=server run db:init",
    "db:reset-admin": "npm --workspace=server run db:reset-admin",
    "test": "npm --workspace=server run test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "zod": "^3.24.2"
  },
  "keywords": [
    "loan-connector",
    "fintech",
    "zippy-loan-connector",
    "hostinger-mysql"
  ],
  "author": "M. Lingaswamy",
  "license": "UNLICENSED"
}
