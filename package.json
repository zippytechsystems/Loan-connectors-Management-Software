{
  "name": "loan-connector-management-software",
  "version": "1.0.0",
  "description": "Zippy Loan Connector Loan Software Application — Independent multi-party loan lead routing and partner network platform (Zippy Enterprises)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "build": "node scripts/build.js",
    "dev": "node --watch --watch-path=src --watch-path=public --watch-path=server.js server.js",
    "test": "node --test tests/api.test.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "migrate:mysql": "node scripts/mysql_migrate.js",
    "migrate:mysql:seed": "node scripts/mysql_migrate.js --seed",
    "backup:mysql": "node scripts/mysql_backup.js",
    "restore:mysql": "node scripts/mysql_restore.js"
  },
  "keywords": [
    "loan-connector",
    "lead-routing",
    "fintech",
    "commissions",
    "partner-network"
  ],
  "author": "Zippy Enterprises Operations Team",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "mysql2": "^3.24.6"
  }
}
